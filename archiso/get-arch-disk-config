#!/usr/bin/env python3
import argparse
import asyncio
import json
import sys
from pathlib import Path


def generate_disk_config(device_path: Path) -> dict:
    from archinstall.lib.disk.device_handler import device_handler
    from archinstall.lib.disk.disk_menu import suggest_single_disk_layout
    from archinstall.lib.models.device import DiskLayoutConfiguration, DiskLayoutType, FilesystemType

    device = device_handler.get_device(device_path)
    if device is None:
        raise RuntimeError(f'Archinstall cannot resolve device: {device_path}')

    modification = asyncio.run(
        suggest_single_disk_layout(
            device,
            filesystem_type=FilesystemType.EXT4,
            separate_home=False,
        )
    )
    config = DiskLayoutConfiguration(
        config_type=DiskLayoutType.Default,
        device_modifications=[modification],
    )
    return config.json()


def merge_config(base: dict, disk_config: dict) -> dict:
    merged = dict(base)
    merged['disk_config'] = disk_config
    return merged


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description='Generate a get-arch Archinstall disk configuration.')
    parser.add_argument('--device', type=Path, required=True)
    parser.add_argument('--base-config', type=Path, required=True)
    parser.add_argument('--output', type=Path, required=True)
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    tmp_path = args.output.with_name(f'.{args.output.name}.tmp')

    try:
        with args.base_config.open('r', encoding='utf-8') as stream:
            base = json.load(stream)
        disk_config = generate_disk_config(args.device)
        merged = merge_config(base, disk_config)
        args.output.parent.mkdir(parents=True, exist_ok=True)
        with tmp_path.open('w', encoding='utf-8') as stream:
            json.dump(merged, stream, indent=2)
            stream.write('\n')
        tmp_path.replace(args.output)
    except Exception as exc:
        try:
            tmp_path.unlink(missing_ok=True)
        except OSError:
            pass
        print(f'get-arch disk config: {exc}', file=sys.stderr)
        return 1

    return 0


if __name__ == '__main__':
    raise SystemExit(main())
